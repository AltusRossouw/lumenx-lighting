node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Admin-uploaded product/category images, spec sheets, manufacturer source PDFs
# and uploaded IES files. In production this path is a persistent Docker volume.
uploads/

# Generated datasheet PDF cache (rendered on demand from the template + JSON).
server/cache/

# Raw supplier IES source dumps — redundant with server/files/ies/ (already
# normalised there) and contain "Don't Send" internal test reports. Kept out of
# version control and out of the public web root.
public/downloads/ies/OrbitX/
public/downloads/ies/Pioled/
public/downloads/ies/Rubicon/
.tools/

# Scrape source artifacts — the raw downloaded product folders and the scraper's
# node_modules are bulky and regenerateable. The catalogue that the site ships
# (src/catalogue-scraped.ts + public/scraped + public/datasheets/<slug>.pdf) is
# produced by data-scrape/generate_catalogue.py, which IS committed.
data-scrape/products/
data-scrape/tools/
data-scrape/product-lists/

# …but keep the reproducible scraper scripts themselves.
!data-scrape/tools/scrape-collections.mjs

# New scraped catalogue (Oct 2026) — ~335MB of images, PDFs and a full site
# payload. Not consumed by src/ yet; held out of version control for now.
scraped-products/

# CocoIndex Code (ccc)
/.cocoindex_code/

# Supplier material supplied by the client — 400MB+ of catalogues, IES dumps and
# a pricing workbook. Must never enter version control (this repo is public).
docs/fromKaylen/

# DSH agent state
.dsh/

# Generated datasheet replacement maps (rebuild with
# scripts/build-datasheet-replacements.py) and Python bytecode.
scripts/examples/generated/
scripts/__pycache__/
__pycache__/

# Scratch from the catalogue/image scripts: a full Chrome profile lands in
# here (Cookies, Login Data, History) and must never be committed.
#
# Both spellings are listed deliberately. The scripts have produced the dotted
# `.catalogue-build/` at some point and the undotted `catalogue-build/` at
# another, and the two are entirely different things: the dotted one is the
# scratch profile, while `catalogue-build/` is a real committed source project
# (build-catalogue.mjs, catalogue-data.mjs, image-map.json, its own
# IMAGE-TREATMENT.md). Only the scratch profile belongs here — do not add the
# undotted directory to this list.
.catalogue-build/
probe-test.png

# Client-supplied source PDFs: the company profile Rev 3 and the 22MB product
# catalogue. The published copy of the company profile lives in
# public/downloads/ and IS committed; these are the working originals, and the
# repo is public.
catalogues/

# Throwaway local Postgres cluster for dev/testing (created by pg_ctl inside the
# workspace so it needs no writes outside the repo). Never committed.
.pgdev/
