# ── LumenX backend — environment ───────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# Runtime
NODE_ENV="production"
HOST="0.0.0.0"          # bind all interfaces inside the container
PORT="4000"

# Public site URL (canonical links + email footers).
PUBLIC_URL="https://www.lumenx.co.za"

# PostgreSQL
# Bundled docker-compose Postgres service (default):
DATABASE_URL="postgres://lumenx:lumenx@db:5432/lumenx"
# External database (override if you host Postgres elsewhere):
# DATABASE_URL="postgres://user:password@your-host:5432/lumenx"

# Auth — generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="lumenx_session"
COOKIE_SECURE="true"    # true when served over HTTPS (Nginx Proxy Manager)

# Key a human admin uses for script/CLI access to admin endpoints.
ADMIN_API_KEY="replace-with-an-admin-key"

# Transactional email (Resend). Leave RESEND_API_KEY empty to disable email
# notifications (leads are still stored and visible in /admin).
RESEND_API_KEY=""
RESEND_FROM="LumenX Lighting <leads@lumenx.co.za>"
LEAD_NOTIFY_EMAIL="projects@lumenx.co.za"

# CORS origins (comma-separated). Same-origin in production; keep the prod URL.
CORS_ORIGINS="https://www.lumenx.co.za"
